-- [[ SMART SERVER HOP V11 - CHỜ HẾT COMBAT MỚI ĐỔI ]] --

local TimeWaiting = 0
_G.AutoHop = true

-- Hàm kiểm tra xem bản thân có đang trong trạng thái Combat không
-- (Dựa trên GUI của Blox Fruits hoặc kiểm tra xem có lấy được Bounty không)
local function IsInCombat()
    local PlayerGui = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
    -- Kiểm tra dòng chữ "In Combat" trên màn hình (Thường nằm trong Main hoặc HUD)
    if PlayerGui then
        -- Cách phổ biến: Quét qua các TextLabel xem cái nào chứa chữ "Combat" và đang hiện
        for _, v in pairs(PlayerGui:GetDescendants()) do
            if v:IsA("TextLabel") and (string.find(string.lower(v.Text), "combat") or string.find(string.lower(v.Text), "giao tranh")) then
                if v.Visible and v.TextTransparency < 1 then
                    return true
                end
            end
        end
    end
    return false
end

